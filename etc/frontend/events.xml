<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!--
        Registers view/frontend/tailwind with Hyvä's config generator so the
        theme's Tailwind build reaches this module's templates.
    -->
    <event name="hyva_config_generate_before">
        <observer name="BlueFairy_CartProductsHyva" instance="BlueFairy\CartProductsHyva\Observer\RegisterModuleForHyvaConfig"/>
    </event>
</config>
