<?php

declare(strict_types=1);

/**
 * Copyright © 2025 Blue Fairy Development. All rights reserved.
 *
 * Hyva Alpine.js cart export button — self-contained component.
 * Gates on canExport() — renders nothing if feature disabled or guest not allowed.
 *
 * Works under Hyvä strict CSP: the component is registered with Alpine.data, every Alpine
 * attribute names a property or method, per-element values come from data-* attributes,
 * and the inline script is registered with $hyvaCsp right after it.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Hyva\Theme\ViewModel\HyvaCsp $hyvaCsp
 * @var \BlueFairy\CartProducts\ViewModel\ExportButton $viewModel
 */

$viewModel = $block->getData('view_model');

if (!$viewModel->canExport()) {
    return;
}
?>
<div x-data="cartExport"
     data-url="<?= $escaper->escapeHtmlAttr($viewModel->getActionUrl()) ?>"
     data-error-message="<?= $escaper->escapeHtmlAttr(__('Export failed. Please try again.')) ?>"
     class="cart-export-wrapper mt-4 mb-4">
    <button @click="download"
            :disabled="loading"
            :aria-busy="busy"
            type="button"
            class="btn btn-primary">
        <span x-show="idle"><?= $escaper->escapeHtml(__('Export Cart')) ?></span>
        <span x-show="loading" x-cloak><?= $escaper->escapeHtml(__('Exporting…')) ?></span>
        <span x-show="downloaded" x-cloak><?= $escaper->escapeHtml(__('Downloaded')) ?></span>
    </button>
    <p x-show="error"
       x-text="error"
       x-cloak
       class="text-red-600 mt-2 text-sm"
       role="alert"></p>
</div>
<script>
(() => {
    function cartExport() {
        return {
            loading: false,
            downloaded: false,
            error: null,
            url: '',
            errorMessage: '',
            init() {
                this.url = this.$el.dataset.url || '';
                this.errorMessage = this.$el.dataset.errorMessage || '';
            },
            idle() {
                return !this.loading && !this.downloaded;
            },
            busy() {
                return this.loading ? 'true' : 'false';
            },
            async download() {
                this.loading = true;
                this.error = null;
                this.downloaded = false;
                const controller = new AbortController();
                const timeout = setTimeout(() => controller.abort(), 30000);
                try {
                    const r = await fetch(this.url, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: new URLSearchParams({ form_key: window.hyva.getFormKey() }),
                        signal: controller.signal
                    });
                    clearTimeout(timeout);
                    if (!r.ok) {
                        throw new Error(this.errorMessage);
                    }
                    const blob = await r.blob();
                    const filename = r.headers.get('X-Filename') ?? 'cart.csv';
                    const a = Object.assign(document.createElement('a'), {
                        href: URL.createObjectURL(blob),
                        download: filename
                    });
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    setTimeout(() => URL.revokeObjectURL(a.href), 100);
                    this.downloaded = true;
                    setTimeout(() => { this.downloaded = false; }, 2000);
                } catch (err) {
                    clearTimeout(timeout);
                    this.error = err.message;
                } finally {
                    this.loading = false;
                }
            }
        };
    }

    window.addEventListener('alpine:init', () => Alpine.data('cartExport', cartExport), { once: true });
})();
</script>
<?php $hyvaCsp->registerInlineScript() ?>
